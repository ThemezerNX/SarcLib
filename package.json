{
  "name": "@themezernx/sarclib",
  "version": "2.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThemezerNX/SarcLib.git"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm run build:types && pnpm run build:esm && pnpm run build:cjs",
    "build:types": "pnpm exec tsc -p tsconfig.build.types.json",
    "build:esm": "pnpm exec tsc -p tsconfig.build.esm.json && node -e \"require('node:fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "build:cjs": "pnpm exec tsc -p tsconfig.build.cjs.json",
    "prepublishOnly": "pnpm run build",
    "publish:package": "pnpm publish --access public --no-git-checks",
    "test": "pnpm exec tsx --test tests/**/*.spec.ts",
    "docs": "typedoc --tsconfig tsconfig.lib.json",
    "lint": "eslint . --ext .ts"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "typedoc>minimatch": "^11.0.1"
    }
  },
  "sideEffects": false,
  "packageManager": "pnpm@10.33.4"
}

