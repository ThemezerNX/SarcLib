{
  "name": "@themezernx/sarclib",
  "version": "2.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThemezerNX/SarcLib.git"
  },
  "scripts": {
    "build": "rm -rf dist && bun run build:types && bun run build:esm && bun run build:cjs",
    "build:types": "tsc -p tsconfig.build.types.json",
    "build:esm": "tsc -p tsconfig.build.esm.json && node -e \"require('node:fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "prepublishOnly": "bun run build",
    "publish:package": "bun publish --access public",
    "test": "bun test",
    "docs": "typedoc --tsconfig tsconfig.lib.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "typedoc": {
      "minimatch": "^11.0.1"
    }
  },
  "sideEffects": false
}

